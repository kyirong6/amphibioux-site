---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site } from "../site";
import vijf from "../images/vijf.jpg";
import rehearsal from "../images/rehearsal.jpeg";

// To add a photo: drop the file in src/images, import it above, and add it here.
const photos = [
  { src: vijf, alt: "Amphibioux performing on stage at the Vancouver International Jazz Festival" },
  { src: rehearsal, alt: "The band rehearsing in a sunlit room, with upright bass, keyboard, congas and horns" },
];
---

<Base title="Photos">
  <p class="small"><a class="link" href="/">← <span class="wordmark">{site.name}</span></a></p>

  <h1>Photos</h1>

  <div class="shots">
    {
      photos.map((photo, i) => (
        <Image src={photo.src} alt={photo.alt} width={1280} loading={i === 0 ? "eager" : "lazy"} />
      ))
    }
  </div>
</Base>

<style>
  h1 { margin-top: 1.5rem; }

  .shots {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
  }
</style>
