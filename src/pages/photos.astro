---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site } from "../site";

import vijf from "../images/vijf.jpg";
import img057 from "../images/img057.jpg";
import img049 from "../images/img049.jpg";
import filmShot from "../images/film_shot.jpg";
import img048 from "../images/img048.jpg";
import img008 from "../images/img008.jpg";
import img146 from "../images/img146.jpg";
import img050 from "../images/img050.jpg";
import rehearsal from "../images/rehearsal.jpeg";
import img042 from "../images/img042.jpg";
import img052 from "../images/img052.jpg";
import img055 from "../images/img055.jpg";
import img006 from "../images/img006.jpg";

// To add a photo: drop the file in src/images, import it above, add it here.
// Photos keep their own shape — the grid flows around whatever you give it.
const photos = [
  { src: vijf, alt: "Amphibioux performing on stage at the Vancouver International Jazz Festival" },
  { src: img057, alt: "A singer at the microphone in a headwrap, with percussion and horns behind her on a red-curtained stage" },
  { src: img049, alt: "Julia Farry singing at the microphone while playing upright bass" },
  { src: filmShot, alt: "The band mid-set in a dim room — trombone in the foreground, drums behind, upright bass at the right" },
  { src: img048, alt: "Julia Farry bowing the upright bass, the drummer playing behind her" },
  { src: img008, alt: "A musician playing berimbau on a couch in front of a painted mural" },
  { src: img146, alt: "The stage at Tyrant Studios seen over the crowd, orange streamers hanging from the ceiling" },
  { src: img050, alt: "Julia Farry playing upright bass beside a lamp with a painted frog shade" },
  { src: rehearsal, alt: "The band rehearsing in a sunlit room, with upright bass, keyboard, congas and horns" },
  { src: img042, alt: "The drum kit between sets, an Amphibioux head on the bass drum and a guitar leaning alongside" },
  { src: img052, alt: "The drummer sitting at his blue kit against a brick wall" },
  { src: img055, alt: "The crowd at Tyrant Studios facing the stage" },
  { src: img006, alt: "The room at Tyrant Studios, streamers over the crowd and a curtained stage beyond" },
];

// A larger copy of each for the fullscreen view — capped so nothing is upscaled.
const full = await Promise.all(
  photos.map((photo) =>
    getImage({ src: photo.src, width: Math.min(2000, photo.src.width), format: "webp" })
  )
);
---

<Base title="Photos" wide>
  <p class="small"><a class="link" href="/">← <span class="wordmark">{site.name}</span></a></p>

  <h1>Photos</h1>

  <div class="grid">
    {
      photos.map((photo, i) => (
        <button
          class="shot"
          type="button"
          data-full={full[i].src}
          data-alt={photo.alt}
          aria-label={`View larger: ${photo.alt}`}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            width={Math.min(900, photo.src.width)}
            loading={i < 4 ? "eager" : "lazy"}
            decoding="async"
          />
        </button>
      ))
    }
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button class="lightbox__close" type="button" aria-label="Close">&times;</button>
    <img alt="" />
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  const full = dialog?.querySelector("img");

  if (dialog && full) {
    document.querySelectorAll<HTMLButtonElement>(".shot").forEach((shot) => {
      shot.addEventListener("click", () => {
        full.src = shot.dataset.full ?? "";
        full.alt = shot.dataset.alt ?? "";
        dialog.showModal();
      });
    });

    dialog.querySelector(".lightbox__close")?.addEventListener("click", () => dialog.close());

    // the photo fills the dialog, so any click inside it closes — which is what the
    // zoom-out cursor promises. Escape closes too, for free.
    dialog.addEventListener("click", () => dialog.close());

    // drop the source on close so a big photo isn't held in memory
    dialog.addEventListener("close", () => full.removeAttribute("src"));
  }
</script>

<style>
  h1 { margin-top: 1.5rem; }

  /* Masonry by way of CSS columns: every photo keeps its own aspect ratio and
     the columns flow around them. No crops, no fixed cell size. */
  .grid {
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
    columns: 1;
    column-gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  @media (min-width: 34rem) { .grid { columns: 2; } }
  @media (min-width: 60rem) { .grid { columns: 3; } }

  .shot {
    display: block;
    width: 100%;
    margin: 0 0 clamp(0.75rem, 2vw, 1.25rem);
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
  }

  .shot img {
    width: 100%;
    height: auto;
    transition: opacity 0.3s ease;
  }

  .shot:hover img,
  .shot:focus-visible img { opacity: 0.82; }

  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }

  .lightbox::backdrop { background: rgba(15, 20, 17, 0.94); }

  .lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(0.5rem, 3vw, 2.5rem);
    cursor: zoom-out;
  }

  .lightbox__close {
    position: absolute;
    top: clamp(0.5rem, 2vw, 1.25rem);
    right: clamp(0.5rem, 2vw, 1.25rem);
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgba(244, 242, 236, 0.14);
    color: #f4f2ec;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .lightbox__close:hover { background: rgba(244, 242, 236, 0.3); }
</style>
