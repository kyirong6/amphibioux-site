---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title="Videos">
  <p class="small"><a class="link" href="/">← <span class="wordmark">{site.name}</span></a></p>

  <h1>Videos</h1>

  <!-- Nothing here yet. To add one, drop an iframe in below:
       <iframe src="https://www.youtube-nocookie.com/embed/VIDEO_ID?rel=0"
               title="…" loading="lazy" allowfullscreen></iframe> -->
  <p class="note small muted">Soon.</p>
</Base>

<style>
  h1 { margin-top: 1.5rem; }

  .note { margin-top: clamp(1.75rem, 5vw, 2.5rem); }

  iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
    background: var(--rule);
  }
</style>
