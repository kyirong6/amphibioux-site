---
import Base from "../layouts/Base.astro";
import { site } from "../site";

// To add a video: put its YouTube id (the part after ?v=) at the top of the list.
const videos = [
  { id: "GN23Uexq4n8", title: "Festa Mágica", meta: "Live at The Fox Cabaret" },
  { id: "4n0k8ZoT6xE", title: "Misturada", meta: "Live at The Fox Cabaret" },
  { id: "uFoRzoS9Bis", title: "Tempo de Amor", meta: "ft. Sara Magal · Live at Vancouver Jazz Festival" },
  { id: "GiPRlSxTb58", title: "Caravan", meta: "Clip · Live at The Fox Cabaret" },
];
---

<Base title="Videos">
  <p class="small"><a class="link" href="/">← <span class="wordmark">{site.name}</span></a></p>

  <h1>Videos</h1>

  <div class="clips">
    {
      videos.map((video) => (
        <figure>
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`}
            title={`${video.title} — ${video.meta}`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            allowfullscreen
          />
          <figcaption class="small">
            {video.title} <span class="muted">{video.meta}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</Base>

<style>
  h1 { margin-top: 1.5rem; }

  .clips {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
  }

  figure { margin: 0; }

  iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: var(--rule);
  }

  figcaption { margin-top: 0.6rem; }
</style>
